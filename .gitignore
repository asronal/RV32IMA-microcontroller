# ============================================================
#  minimal_mcu — .gitignore
# ============================================================

# ------- Compiled / simulation binaries ---------------------
sim/sim_tb_*
sim/sim_*
sim/mcu_waves.vcd
sim/sim_cycles.tsv

# ------- Firmware build artifacts ---------------------------
sw/build/

# ------- Simulation / waveform dumps (large generated data) -
*.vcd
*.fsdb
*.lxt
*.lxt2

# ------- Visualizer generated data (regenerated by run_tests.py) --
visualizer/data.js

# ------- PDK / Library binary files -------------------------
pdk/
*.db
*.lib

# ------- Synthesis outputs ----------------------------------
syn/results/
syn/reports/
syn/work/
syn/*.ddc
syn/*.svf
syn/*.log
syn/*.pvl
syn/*.mr
syn/*.syn
*.vg
*.sdf

# ------- Editor / OS junk -----------------------------------
*.Zone.Identifier
*:Zone.Identifier
.DS_Store
Thumbs.db
.vscode/
*.swp
*.swo
*~

# ------- Python cache ---------------------------------------
__pycache__/
*.pyc
*.pyo
